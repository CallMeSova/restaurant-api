# Port to run the server on locally
PORT=3000

# Supabase Configuration
# The URL of your Supabase project (e.g. https://xxxxxx.supabase.co)
SUPABASE_URL=

# Supabase API key (prefer Service Role Key for full RLS bypass, or Anon Key if RLS handles it)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET=
